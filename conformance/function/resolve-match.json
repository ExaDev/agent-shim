{
  "cases": [
    {
      "from": "resolve/match.test.ts: canonicaliseEntryKey > strips the category prefix and keeps the rest as written",
      "id": "match.canonicalise.strips-the-category-prefix",
      "kind": "function",
      "steps": [
        {
          "args": [
            "knowledge/skills/commit",
            "/h"
          ],
          "expect": {
            "value": {
              "canonicalPattern": "skills/commit",
              "declaredCategory": "knowledge"
            }
          },
          "fn": "canonicaliseEntryKey"
        }
      ]
    },
    {
      "from": "resolve/match.test.ts: canonicaliseEntryKey > keeps the declared category so the resolver can cross-check it against the real classification",
      "id": "match.canonicalise.keeps-the-declared-category",
      "kind": "function",
      "steps": [
        {
          "args": [
            "runtime/.credentials.json",
            "/h"
          ],
          "expect": {
            "value": "runtime"
          },
          "fn": "canonicaliseEntryKey",
          "select": [
            "declaredCategory"
          ]
        }
      ]
    },
    {
      "from": "resolve/match.test.ts: canonicaliseEntryKey > encodes a history/projects/ fragment as a real path, since that directory's only children are encoded names",
      "id": "match.canonicalise.encodes-a-project-fragment",
      "kind": "function",
      "steps": [
        {
          "args": [
            "history/projects/~/work/clients/*",
            "/h"
          ],
          "expect": {
            "value": "projects/-h-work-clients-*"
          },
          "fn": "canonicaliseEntryKey",
          "select": [
            "canonicalPattern"
          ]
        },
        {
          "args": [
            "history/projects/~/work/clients/*",
            "/h"
          ],
          "expect": {
            "value": "~/work/clients/*"
          },
          "fn": "canonicaliseEntryKey",
          "select": [
            "projectFragment"
          ]
        }
      ]
    },
    {
      "from": "resolve/match.test.ts: canonicaliseEntryKey > applies the project encoding nowhere else — every other key is a literal path or an ordinary glob",
      "id": "match.canonicalise.encodes-nowhere-else",
      "kind": "function",
      "steps": [
        {
          "args": [
            "history/sessions/~weird",
            "/h"
          ],
          "expect": {
            "value": "sessions/~weird"
          },
          "fn": "canonicaliseEntryKey",
          "select": [
            "canonicalPattern"
          ]
        },
        {
          "args": [
            "knowledge/skills/a.b.c",
            "/h"
          ],
          "expect": {
            "value": "skills/a.b.c"
          },
          "fn": "canonicaliseEntryKey",
          "select": [
            "canonicalPattern"
          ]
        }
      ]
    },
    {
      "from": "resolve/match.test.ts: canonicaliseEntryKey > normalises redundant separators and `.` segments outside history/projects/",
      "id": "match.canonicalise.normalises-separators",
      "kind": "function",
      "steps": [
        {
          "args": [
            "skills//commit/"
          ],
          "expect": {
            "value": "skills/commit"
          },
          "fn": "normaliseRelative"
        },
        {
          "args": [
            "knowledge/./skills//commit/",
            "/h"
          ],
          "expect": {
            "value": "skills/commit"
          },
          "fn": "canonicaliseEntryKey",
          "select": [
            "canonicalPattern"
          ]
        }
      ]
    },
    {
      "from": "resolve/match.test.ts: canonicaliseEntryKey > rejects a key with no category prefix",
      "id": "match.canonicalise.rejects-a-key-without-a-category",
      "kind": "function",
      "steps": [
        {
          "args": [
            "skills/commit-only",
            "/h"
          ],
          "expect": {
            "throws": {
              "name": "EntryKeyError"
            }
          },
          "fn": "canonicaliseEntryKey"
        }
      ]
    },
    {
      "from": "resolve/match.test.ts: canonicaliseEntryKey > rejects a history/projects/ fragment that is not rooted",
      "id": "match.canonicalise.rejects-an-unrooted-project-fragment",
      "kind": "function",
      "steps": [
        {
          "args": [
            "history/projects/work/acme",
            "/h"
          ],
          "expect": {
            "throws": {
              "name": "EntryKeyError"
            }
          },
          "fn": "canonicaliseEntryKey"
        }
      ]
    },
    {
      "from": "resolve/match.test.ts: canonicaliseEntryKey > collapses two syntactically different but equivalent project keys to one canonical pattern",
      "id": "match.canonicalise.collapses-equivalent-project-keys",
      "kind": "function",
      "steps": [
        {
          "args": [
            "history/projects/~/work/x",
            "/h"
          ],
          "expect": {
            "value": "projects/-h-work-x"
          },
          "fn": "canonicaliseEntryKey",
          "select": [
            "canonicalPattern"
          ]
        },
        {
          "args": [
            "history/projects//h/work/x",
            "/h"
          ],
          "expect": {
            "value": "projects/-h-work-x"
          },
          "fn": "canonicaliseEntryKey",
          "select": [
            "canonicalPattern"
          ]
        }
      ]
    },
    {
      "from": "resolve/match.test.ts: compileMatcher > matches the pattern itself and everything beneath it, so a rule on a directory covers its contents",
      "id": "match.matcher.covers-the-subtree",
      "kind": "function",
      "steps": [
        {
          "args": [
            "skills",
            "skills"
          ],
          "expect": {
            "value": true
          },
          "fn": "compileMatcher"
        },
        {
          "args": [
            "skills",
            "skills/commit"
          ],
          "expect": {
            "value": true
          },
          "fn": "compileMatcher"
        },
        {
          "args": [
            "skills",
            "skills/commit/SKILL.md"
          ],
          "expect": {
            "value": true
          },
          "fn": "compileMatcher"
        },
        {
          "args": [
            "skills",
            "agents"
          ],
          "expect": {
            "value": false
          },
          "fn": "compileMatcher"
        }
      ]
    },
    {
      "from": "resolve/match.test.ts: compileMatcher > covers the contents of a glob-matched directory too",
      "id": "match.matcher.covers-a-glob-matched-subtree",
      "kind": "function",
      "steps": [
        {
          "args": [
            "projects/-a-b-*",
            "projects/-a-b-c"
          ],
          "expect": {
            "value": true
          },
          "fn": "compileMatcher"
        },
        {
          "args": [
            "projects/-a-b-*",
            "projects/-a-b-c/session.jsonl"
          ],
          "expect": {
            "value": true
          },
          "fn": "compileMatcher"
        },
        {
          "args": [
            "projects/-a-b-*",
            "projects/-x-y-z"
          ],
          "expect": {
            "value": false
          },
          "fn": "compileMatcher"
        }
      ]
    },
    {
      "from": "resolve/match.test.ts: compileMatcher > matches a leading-dot entry, which a glob would otherwise skip",
      "id": "match.matcher.matches-a-leading-dot",
      "kind": "function",
      "steps": [
        {
          "args": [
            ".git*",
            ".gitignore"
          ],
          "expect": {
            "value": true
          },
          "fn": "compileMatcher"
        }
      ]
    },
    {
      "from": "resolve/match.test.ts: compileMatcher > matches case-sensitively whatever the host filesystem does",
      "id": "match.matcher.is-case-sensitive",
      "kind": "function",
      "steps": [
        {
          "args": [
            "skills",
            "Skills"
          ],
          "expect": {
            "value": false
          },
          "fn": "compileMatcher"
        }
      ]
    },
