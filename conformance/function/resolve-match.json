    {
      "from": "resolve/match.test.ts: compareSpecificity > ranks a later layer above an earlier one, whatever their exactness",
      "id": "match.specificity.later-layer-wins",
      "kind": "function",
      "steps": [
        {
          "args": [
            {
              "canonicalPattern": "skills/*",
              "layer": 3,
              "ordinal": 0
            },
            {
              "canonicalPattern": "skills/commit",
              "layer": 1,
              "ordinal": 0
            }
          ],
          "expect": {
            "value": 1
          },
          "fn": "compareSpecificity.sign"
        },
        {
          "args": [
            {
              "canonicalPattern": "skills/commit",
              "layer": 1,
              "ordinal": 0
            },
            {
              "canonicalPattern": "skills/*",
              "layer": 3,
              "ordinal": 0
            }
          ],
          "expect": {
            "value": -1
          },
          "fn": "compareSpecificity.sign"
        }
      ]
    },
    {
      "from": "resolve/match.test.ts: compareSpecificity > ranks an exact literal above a glob within the same layer",
      "id": "match.specificity.exact-beats-glob",
      "kind": "function",
      "steps": [
        {
          "args": [
            {
              "canonicalPattern": "skills/commit",
              "layer": 2,
              "ordinal": 1
            },
            {
              "canonicalPattern": "skills/*",
              "layer": 2,
              "ordinal": 0
            }
          ],
          "expect": {
            "value": 1
          },
          "fn": "compareSpecificity.sign"
        }
      ]
    },
    {
      "from": "resolve/match.test.ts: compareSpecificity > ranks the longer literal prefix above the shorter one within the same layer",
      "id": "match.specificity.longer-prefix-wins",
