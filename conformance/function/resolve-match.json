    {
      "from": "resolve/match.test.ts: compareSpecificity > is a total order — it never returns 0 for two distinct rules, which would make the winner iteration-order-dependent",
      "id": "match.specificity.is-a-total-order",
      "kind": "function",
      "steps": [
        {
          "args": [
            {
              "canonicalPattern": "a/*",
