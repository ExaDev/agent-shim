    {
      "from": "resolve/projects.test.ts: detectEncodingAmbiguity > flags a literal containing a character besides `/` that encodes to `-`",
      "id": "projects.ambiguity.flags-a-lossy-literal",
      "kind": "function",
      "steps": [
        {
          "args": [
            [
              "~/work/app-v1.2"
            ],
            "/h",
            "lossy-characters"
          ],
          "expect": {
            "value": true
          },
          "fn": "detectEncodingAmbiguity.hasReason"
        }
      ]
    },
    {
      "from": "resolve/projects.test.ts: detectEncodingAmbiguity > does not flag a literal whose only lossy characters are separators",
      "id": "projects.ambiguity.ignores-separators",
      "kind": "function",
      "steps": [
        {
          "args": [
            [
              "~/work/clients/acme"
            ],
            "/h"
          ],
          "expect": {
            "value": []
          },
          "fn": "detectEncodingAmbiguity"
        }
      ]
    },
    {
      "from": "resolve/projects.test.ts: detectEncodingAmbiguity > flags two distinct fragments that encode identically, which proves a collision outright",
      "id": "projects.ambiguity.flags-a-collision",
      "kind": "function",
      "steps": [
        {
          "args": [
            [
              "/work/clients/acme",
              "/work/clients-acme"
            ],
            "/h",
            "collides-with-sibling-pattern"
          ],
          "expect": {
            "value": 2
          },
          "fn": "detectEncodingAmbiguity.byReason",
          "select": [
            "length"
          ]
        },
        {
          "args": [
            [
              "/work/clients/acme",
              "/work/clients-acme"
            ],
            "/h",
            "collides-with-sibling-pattern"
          ],
          "expect": {
            "value": "-work-clients-acme"
          },
          "fn": "detectEncodingAmbiguity.byReason",
          "select": [
            "0",
            "encoded"
          ]
        }
      ]
    },
    {
      "from": "resolve/projects.test.ts: detectEncodingAmbiguity > reports how many real project directories the encoded form currently matches, when given the listing",
      "id": "projects.ambiguity.counts-existing-directories",
      "kind": "function",
      "steps": [
        {
          "args": [
            [
              "~/work/app.v1"
            ],
            "/h",
            [
              "-h-work-app-v1",
              "-h-other"
            ],
            "matches 1 existing project directory name(s)"
          ],
          "expect": {
            "value": true
          },
          "fn": "detectEncodingAmbiguity.firstDetailContains"
        }
      ]
    },
    {
      "from": "resolve/projects.test.ts: detectEncodingAmbiguity > skips a fragment it cannot encode rather than throwing mid-report",
      "id": "projects.ambiguity.skips-an-unencodable-fragment",
      "kind": "function",
      "steps": [
        {
          "args": [
            [
              "not-rooted"
            ],
            "/h"
          ],
          "expect": {
            "value": []
          },
          "fn": "detectEncodingAmbiguity"
        }
      ]
    }
  ]
