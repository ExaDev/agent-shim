    {
      "from": "resolve/projects.test.ts: encodeProjectPath > preserves case rather than lowercasing",
      "id": "projects.encode-path.preserves-case",
      "kind": "function",
      "steps": [
        {
          "args": [
            "/A/b/CdE"
          ],
          "expect": {
            "value": "-A-b-CdE"
          },
          "fn": "encodeProjectPath"
        }
      ]
    },
    {
      "from": "resolve/projects.test.ts: encodeProjectPath > collapses `.` and `_` and ` ` exactly as it collapses `/`, which is what makes the encoding many-to-one",
      "id": "projects.encode-path.is-many-to-one",
      "kind": "function",
      "steps": [
        {
          "args": [
            "/a/b-c"
          ],
          "expect": {
            "value": "-a-b-c"
          },
          "fn": "encodeProjectPath"
        },
        {
          "args": [
            "/a-b-c"
          ],
          "expect": {
            "value": "-a-b-c"
          },
          "fn": "encodeProjectPath"
        },
        {
          "args": [
            "/a/b.c"
          ],
          "expect": {
            "value": "-a-b-c"
          },
          "fn": "encodeProjectPath"
        },
        {
          "args": [
            "/a/b/c"
          ],
          "expect": {
            "value": "-a-b-c"
          },
          "fn": "encodeProjectPath"
        }
      ]
    },
    {
      "from": "resolve/projects.test.ts: splitOnWildcards > keeps wildcard tokens out of the literal runs, so encoding never turns a `*` into a `-`",
      "id": "projects.split.keeps-wildcards-out-of-literals",
      "kind": "function",
      "steps": [
        {
          "args": [
            "/a/b/*"
          ],
          "expect": {
            "value": [
              {
                "kind": "literal",
                "text": "/a/b/"
              },
              {
                "kind": "wildcard",
                "text": "*"
              }
            ]
          },
          "fn": "splitOnWildcards"
        }
      ]
    },
    {
      "from": "resolve/projects.test.ts: splitOnWildcards > treats `**` as one token rather than two `*`",
      "id": "projects.split.double-star-is-one-token",
      "kind": "function",
      "steps": [
        {
          "args": [
            "/a/**/b"
          ],
          "expect": {
            "value": [
              {
                "kind": "literal",
                "text": "/a/"
              },
              {
                "kind": "wildcard",
                "text": "**"
              },
              {
                "kind": "literal",
                "text": "/b"
              }
            ]
          },
          "fn": "splitOnWildcards"
        }
      ]
    },
    {
      "from": "resolve/projects.test.ts: splitOnWildcards > handles `?` and adjacent wildcards",
      "id": "projects.split.question-mark-and-adjacent",
      "kind": "function",
      "steps": [
        {
          "args": [
            "?*x"
          ],
          "expect": {
            "value": [
              {
                "kind": "wildcard",
                "text": "?"
              },
              {
                "kind": "wildcard",
                "text": "*"
              },
              {
                "kind": "literal",
                "text": "x"
              }
            ]
          },
          "fn": "splitOnWildcards"
        }
      ]
    },
    {
      "from": "resolve/projects.test.ts: expandHome > expands a leading `~/`",
      "id": "projects.expand-home.leading-tilde-slash",
      "kind": "function",
      "steps": [
        {
          "args": [
            "~/work",
            "/h"
          ],
          "expect": {
            "value": "/h/work"
          },
          "fn": "expandHome"
        }
      ]
    },
    {
      "from": "resolve/projects.test.ts: expandHome > expands a bare `~`",
      "id": "projects.expand-home.bare-tilde",
      "kind": "function",
      "steps": [
        {
          "args": [
            "~",
            "/h"
          ],
          "expect": {
            "value": "/h"
          },
          "fn": "expandHome"
        }
      ]
    },
    {
      "from": "resolve/projects.test.ts: expandHome > leaves a `~` that is not the first character alone",
      "id": "projects.expand-home.not-first",
      "kind": "function",
      "steps": [
        {
          "args": [
            "/a/~b",
            "/h"
          ],
          "expect": {
            "value": "/a/~b"
          },
          "fn": "expandHome"
        }
      ]
    },
    {
      "from": "resolve/projects.test.ts: expandHome > does not expand `~name`, which is another user's home, not this one's",
      "id": "projects.expand-home.another-users-home",
      "kind": "function",
      "steps": [
        {
          "args": [
            "~bob/work",
            "/h"
          ],
          "expect": {
            "value": "~bob/work"
          },
          "fn": "expandHome"
        }
      ]
    },
    {
      "from": "resolve/projects.test.ts: encodeProjectPattern > expands `~` before encoding, never after — encoding first would turn the `~` into a `-` and lose the reference",
      "id": "projects.encode-pattern.expands-before-encoding",
      "kind": "function",
      "steps": [
        {
          "args": [
            "~/work/clients/acme",
            "/h"
          ],
          "expect": {
            "value": "-h-work-clients-acme"
          },
          "fn": "encodeProjectPattern"
        },
        {
          "args": [
            "/h/work/clients/acme"
          ],
          "expect": {
            "value": "-h-work-clients-acme"
          },
          "fn": "encodeProjectPath"
        }
      ]
    },
    {
      "from": "resolve/projects.test.ts: encodeProjectPattern > carries wildcard tokens through encoding as wildcards",
      "id": "projects.encode-pattern.carries-wildcards",
      "kind": "function",
      "steps": [
        {
          "args": [
            "~/work/clients/*",
            "/h"
          ],
          "expect": {
            "value": "-h-work-clients-*"
          },
          "fn": "encodeProjectPattern"
        },
        {
          "args": [
            "~/work/**",
            "/h"
          ],
          "expect": {
            "value": "-h-work-**"
          },
          "fn": "encodeProjectPattern"
        },
        {
          "args": [
            "/a/?/b",
            "/h"
          ],
          "expect": {
            "value": "-a-?-b"
          },
          "fn": "encodeProjectPattern"
        }
      ]
    },
    {
      "from": "resolve/projects.test.ts: encodeProjectPattern > encodes an absolute path with no `~` at all",
      "id": "projects.encode-pattern.absolute-path",
      "kind": "function",
      "steps": [
        {
          "args": [
            "/var/tmp/x",
            "/h"
          ],
          "expect": {
            "value": "-var-tmp-x"
          },
          "fn": "encodeProjectPattern"
        }
      ]
    },
    {
      "from": "resolve/projects.test.ts: encodeProjectPattern > rejects a fragment that is neither home-rooted nor absolute",
      "id": "projects.encode-pattern.rejects-an-unrooted-fragment",
      "kind": "function",
      "steps": [
        {
          "args": [
            "work/clients/acme",
            "/h"
          ],
          "expect": {
            "throws": {
              "name": "UnrootedProjectPathError"
            }
          },
          "fn": "encodeProjectPattern"
        },
        {
          "args": [
            "*",
            "/h"
          ],
          "expect": {
            "throws": {
              "name": "UnrootedProjectPathError"
            }
          },
          "fn": "encodeProjectPattern"
        }
      ]
    },
    {
