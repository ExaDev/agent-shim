{
  "cases": [
    {
      "from": "paths.test.ts: resolveAgentShimHome > prefers AGENT_SHIM_HOME over any directory under the home directory",
      "id": "paths.resolve-home.environment-wins",
      "kind": "function",
      "steps": [
        {
          "args": [
            {
              "AGENT_SHIM_HOME": "/elsewhere"
            },
            "/home/u",
            true
          ],
          "expect": {
            "value": "/elsewhere"
          },
          "fn": "resolveAgentShimHome"
        }
      ]
    },
    {
      "from": "paths.test.ts: resolveAgentShimHome > treats an empty AGENT_SHIM_HOME as unset",
      "id": "paths.resolve-home.empty-environment-is-unset",
      "kind": "function",
      "steps": [
        {
          "args": [
            {
              "AGENT_SHIM_HOME": ""
            },
            "/home/u",
            false
          ],
          "expect": {
            "value": "/home/u/.agent-shim"
          },
          "fn": "resolveAgentShimHome"
        }
      ]
    },
    {
      "from": "paths.test.ts: resolveAgentShimHome > uses ~/.agent-shim on a fresh installation",
      "id": "paths.resolve-home.fresh-installation",
      "kind": "function",
      "steps": [
        {
          "args": [
            {},
            "/home/u",
            false
          ],
          "expect": {
            "value": "/home/u/.agent-shim"
          },
          "fn": "resolveAgentShimHome"
        }
      ]
    },
    {
      "from": "paths.test.ts: resolveAgentShimHome > adopts an existing ~/.claude-use in place when ~/.agent-shim does not exist",
      "id": "paths.resolve-home.adopts-legacy",
      "kind": "function",
      "steps": [
        {
          "args": [
            {},
            "/home/u",
            [
              "/home/u/.claude-use"
            ]
          ],
          "expect": {
            "value": "/home/u/.claude-use"
          },
          "fn": "resolveAgentShimHome"
        }
      ]
    },
    {
      "from": "paths.test.ts: resolveAgentShimHome > prefers ~/.agent-shim when both directories exist",
      "id": "paths.resolve-home.prefers-current",
      "kind": "function",
      "steps": [
        {
          "args": [
            {},
            "/home/u",
            true
          ],
          "expect": {
            "value": "/home/u/.agent-shim"
          },
          "fn": "resolveAgentShimHome"
        }
      ]
    },
