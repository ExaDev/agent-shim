{
  "cases": [
    {
      "from": "resolve/extends.test.ts: lineariseProfile > emits a linear chain base-first",
      "id": "extends.linearise.chain-base-first",
      "kind": "function",
      "steps": [
        {
          "args": [
            "client-acme",
            {
              "base": {
                "profile": {}
              },
              "client-acme": {
                "profile": {
                  "extends": [
                    "work"
                  ]
                }
              },
              "work": {
                "profile": {
                  "extends": [
                    "base"
                  ]
                }
              }
            }
          ],
          "expect": {
            "value": [
              "base",
              "work",
              "client-acme"
            ]
          },
          "fn": "lineariseProfile",
          "select": [
            "order"
          ]
        }
      ]
    },
