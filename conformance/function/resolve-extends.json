    {
      "from": "resolve/extends.test.ts: diamond extends > emits the shared base exactly once, post-order, rather than re-emitting it per branch",
      "id": "extends.diamond.base-once-post-order",
      "kind": "function",
      "steps": [
        {
          "args": [
            "c",
            {
              "a": {
                "profile": {
                  "categories": {
                    "history": false
                  },
                  "extends": [
                    "base"
                  ]
                }
              },
              "b": {
                "profile": {
                  "extends": [
                    "base"
                  ]
                }
              },
              "base": {
                "profile": {
                  "categories": {
                    "history": true,
                    "knowledge": true
                  }
                }
              },
              "c": {
                "profile": {
                  "extends": [
                    "a",
                    "b"
                  ]
                }
              }
            }
          ],
          "expect": {
            "value": [
              "base",
              "a",
              "b",
              "c"
            ]
          },
          "fn": "lineariseProfile",
          "select": [
            "order"
          ]
        }
      ]
    },
