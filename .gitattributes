# Secret-redaction filter drivers.
# Applied to every text file class that could carry a pasted secret in a code
# snippet or config example. Binaries are excluded so the text filter never
# mangles them. Requires the local git config from .githooks/git-filter-clean
# (see README) — a fresh clone must re-run that setup step, git config is
# never committed.
*.md     filter=secrets merge=text
*.ts     filter=secrets merge=text
*.tsx    filter=secrets merge=text
*.mts    filter=secrets merge=text
*.mjs    filter=secrets merge=text
*.txt    filter=secrets merge=text
*.json   filter=secrets merge=text
*.jsonc  filter=secrets merge=text
*.yaml   filter=secrets merge=text
*.yml    filter=secrets merge=text
*.toml   filter=secrets merge=text
*.sql    filter=secrets merge=text
*.sh     filter=secrets merge=text
*.bash   filter=secrets merge=text
*.diff   filter=secrets merge=text

# A fixture that is deliberately not UTF-8 must reach the object store byte for byte, and the text filter refuses input that is not UTF-8.
conformance/fixtures/invalid-cases/file-not-utf8.json -filter -merge
