{
  "$id": "https://github.com/ExaDev/agent-shim/schema/AgentTree.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "project": {
      "type": "string"
    },
    "sessionId": {
      "type": "string"
    },
    "superseded": {
      "type": "boolean"
    },
    "agents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "activeForm": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "metadata": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "blocks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "blockedBy": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "taskList": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "subject",
          "status",
          "blocks",
          "blockedBy"
        ],
        "additionalProperties": false
      }
    },
    "workflowRuns": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "runId": {
            "type": "string"
          },
          "workflowName": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "startTime": {
            "type": "number"
          },
          "phases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "summary": {
            "type": "string"
          }
        },
        "required": [
          "runId",
          "phases"
        ],
        "additionalProperties": false
      }
    },
    "problems": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "project",
    "sessionId",
    "superseded",
    "agents",
    "tasks",
    "workflowRuns",
    "problems"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "subagent",
            "fork",
            "workflow-agent",
            "teammate"
          ]
        },
        "agentType": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "toolUseId": {
          "type": "string"
        },
        "spawnDepth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "model": {
          "type": "string"
        },
        "background": {
          "type": "boolean"
        },
        "workflowRunId": {
          "type": "string"
        },
        "workflowPhase": {
          "type": "string"
        },
        "teamName": {
          "type": "string"
        },
        "stoppedByUser": {
          "type": "boolean"
        },
        "transcript": {
          "type": "string"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        }
      },
      "required": [
        "id",
        "kind",
        "agentType",
        "transcript",
        "children"
      ],
      "additionalProperties": false
    }
  }
}
