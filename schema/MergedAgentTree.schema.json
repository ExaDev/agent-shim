{
  "$id": "https://github.com/ExaDev/agent-shim/schema/MergedAgentTree.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "project": {
      "type": "string"
    },
    "sessionId": {
      "type": "string"
    },
    "superseded": {
      "type": "boolean"
    },
    "agents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "activeForm": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "metadata": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "blocks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "blockedBy": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "taskList": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "subject",
          "status",
          "blocks",
          "blockedBy"
        ],
        "additionalProperties": false
      }
    },
    "workflowRuns": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "runId": {
            "type": "string"
          },
          "workflowName": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "startTime": {
            "type": "number"
          },
          "phases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "summary": {
            "type": "string"
          }
        },
        "required": [
          "runId",
          "phases"
        ],
        "additionalProperties": false
      }
    },
    "problems": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "remoteSessions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "liveOnly": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "taskId": {
            "type": "string"
          },
          "sessionId": {
            "type": "string"
          },
          "runId": {
            "type": "string"
          },
          "toolUseId": {
            "type": "string"
          },
          "taskType": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "subagentType": {
            "type": "string"
          },
          "spawnDepth": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "parentTaskId": {
            "type": "string"
          },
          "backgrounded": {
            "type": "boolean"
          },
          "status": {
            "type": "string"
          },
          "outputFile": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "lastToolName": {
            "type": "string"
          },
          "usage": {
            "type": "object",
            "properties": {
              "totalTokens": {
                "type": "number"
              },
              "toolUses": {
                "type": "number"
              },
              "durationMs": {
                "type": "number"
              }
            },
            "additionalProperties": false
          },
          "observedAt": {
            "type": "number"
          }
        },
        "required": [
          "taskId",
          "sessionId",
          "status",
          "observedAt"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "project",
    "sessionId",
    "superseded",
    "agents",
    "tasks",
    "workflowRuns",
    "problems",
    "remoteSessions",
    "liveOnly"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "subagent",
            "fork",
            "workflow-agent",
            "teammate"
          ]
        },
        "agentType": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "toolUseId": {
          "type": "string"
        },
        "spawnDepth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "model": {
          "type": "string"
        },
        "background": {
          "type": "boolean"
        },
        "workflowRunId": {
          "type": "string"
        },
        "workflowPhase": {
          "type": "string"
        },
        "teamName": {
          "type": "string"
        },
        "stoppedByUser": {
          "type": "boolean"
        },
        "transcript": {
          "type": "string"
        },
        "provenance": {
          "type": "string",
          "enum": [
            "disk",
            "both"
          ]
        },
        "live": {
          "type": "object",
          "properties": {
            "taskId": {
              "type": "string"
            },
            "sessionId": {
              "type": "string"
            },
            "runId": {
              "type": "string"
            },
            "toolUseId": {
              "type": "string"
            },
            "taskType": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "subagentType": {
              "type": "string"
            },
            "spawnDepth": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "parentTaskId": {
              "type": "string"
            },
            "backgrounded": {
              "type": "boolean"
            },
            "status": {
              "type": "string"
            },
            "outputFile": {
              "type": "string"
            },
            "summary": {
              "type": "string"
            },
            "lastToolName": {
              "type": "string"
            },
            "usage": {
              "type": "object",
              "properties": {
                "totalTokens": {
                  "type": "number"
                },
                "toolUses": {
                  "type": "number"
                },
                "durationMs": {
                  "type": "number"
                }
              },
              "additionalProperties": false
            },
            "observedAt": {
              "type": "number"
            }
          },
          "required": [
            "taskId",
            "sessionId",
            "status",
            "observedAt"
          ],
          "additionalProperties": false
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        }
      },
      "required": [
        "id",
        "kind",
        "agentType",
        "transcript",
        "provenance",
        "children"
      ],
      "additionalProperties": false
    }
  }
}
