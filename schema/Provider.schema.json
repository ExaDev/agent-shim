{
  "$id": "https://github.com/ExaDev/claude-use/schema/Provider.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "baseUrl": {
      "type": "string",
      "format": "uri"
    },
    "tokenEnv": {
      "type": "string",
      "minLength": 1
    },
    "tokenCommand": {
      "type": "array",
      "prefixItems": [
        {
          "type": "string",
          "minLength": 1
        }
      ],
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "authScheme": {
      "type": "string",
      "enum": [
        "bearer",
        "apiKey"
      ]
    },
    "env": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "required": [
    "displayName",
    "baseUrl"
  ],
  "additionalProperties": false
}
