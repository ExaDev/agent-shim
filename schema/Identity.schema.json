{
  "$id": "https://github.com/ExaDev/claude-use/schema/Identity.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._@-]*$"
    },
    "defaultConfigProfile": {
      "type": "string",
      "minLength": 1
    },
    "allowAmbientCredential": {
      "default": false,
      "type": "boolean"
    },
    "credential": {
      "type": "object",
      "properties": {
        "sources": {
          "minItems": 1,
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "env": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "env"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "file"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "command": {
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": "string",
                        "minLength": 1
                      }
                    ],
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1
                  },
                  "interactive": {
                    "type": "boolean"
                  },
                  "timeoutMs": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "command"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "op": {
                    "type": "string",
                    "format": "starts_with",
                    "pattern": "^op:\\/\\/.*"
                  },
                  "interactive": {
                    "type": "boolean"
                  },
                  "timeoutMs": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "op"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "keychain": {
                    "type": "object",
                    "properties": {
                      "service": {
                        "type": "string",
                        "minLength": 1
                      },
                      "account": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "service"
                    ],
                    "additionalProperties": false
                  },
                  "interactive": {
                    "type": "boolean"
                  },
                  "timeoutMs": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "keychain"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "literal": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "literal"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "target": {
          "type": "string",
          "enum": [
            "bearer",
            "apiKey",
            "oauthToken"
          ]
        }
      },
      "required": [
        "sources"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "name"
  ],
  "additionalProperties": false
}
