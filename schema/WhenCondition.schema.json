{
  "$id": "https://github.com/ExaDev/agent-shim/schema/WhenCondition.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "newerThan": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)(?:ms|s|m|h|d|w)$"
    },
    "olderThan": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)(?:ms|s|m|h|d|w)$"
    },
    "maxSizeBytes": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "env": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
