{
  "$id": "https://github.com/ExaDev/agent-shim/schema/GlobalConfig.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "defaultConfigProfile": {
      "type": "string",
      "minLength": 1
    },
    "walkUpLimit": {
      "type": "string",
      "minLength": 1
    },
    "categories": {
      "type": "object",
      "properties": {
        "all": {
          "type": "boolean"
        },
        "runtime": {
          "type": "boolean"
        },
        "history": {
          "type": "boolean"
        },
        "knowledge": {
          "type": "boolean"
        },
        "settings": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "entries": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^(?:secret|runtime|history|knowledge|settings)\\/(?!\\/)\\S(?:.*\\S)?$"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "boolean"
          },
          {
            "type": "object",
            "properties": {
              "value": {
                "type": "boolean"
              },
              "when": {
                "type": "object",
                "properties": {
                  "newerThan": {
                    "type": "string",
                    "pattern": "^(?:0|[1-9][0-9]*)(?:ms|s|m|h|d|w)$"
                  },
                  "olderThan": {
                    "type": "string",
                    "pattern": "^(?:0|[1-9][0-9]*)(?:ms|s|m|h|d|w)$"
                  },
                  "maxSizeBytes": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "branch": {
                    "type": "string",
                    "minLength": 1
                  },
                  "env": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string",
                      "minLength": 1
                    },
                    "additionalProperties": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              }
            },
            "required": [
              "value",
              "when"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "launch": {
      "type": "object",
      "properties": {
        "skipPermissions": {
          "type": "boolean"
        },
        "remoteControl": {
          "type": "boolean"
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "headroom": {
          "type": "boolean"
        },
        "trackUsage": {
          "type": "boolean"
        },
        "claudeVersion": {
          "type": "string",
          "pattern": "^\\d+(?:\\.\\d+)*$"
        }
      },
      "additionalProperties": false
    },
    "headroom": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "idleShutdownMinutes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "mode": {
          "type": "string",
          "enum": [
            "cache",
            "token"
          ]
        },
        "targetRatio": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "ccr": {
          "type": "string",
          "enum": [
            "default",
            "lossless",
            "none"
          ]
        },
        "rolloutChannel": {
          "type": "string",
          "enum": [
            "beta",
            "canary",
            "dev"
          ]
        },
        "interceptToolResults": {
          "type": "boolean"
        },
        "readMaturation": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "frontdoor": {
      "type": "object",
      "properties": {
        "idleShutdownMinutes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "update": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "off",
            "notify",
            "auto"
          ]
        }
      },
      "additionalProperties": false
    },
    "pools": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "identities": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(pool:[A-Za-z0-9][A-Za-z0-9._-]*|[A-Za-z0-9][A-Za-z0-9._@-]*)$"
            }
          },
          "preference": {
            "type": "string",
            "enum": [
              "score",
              "listed"
            ]
          }
        },
        "required": [
          "identities"
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
