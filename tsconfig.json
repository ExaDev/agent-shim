{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "preserve",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "types": ["node"],
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true,
    "incremental": true,
    "tsBuildInfoFile": "tsconfig.tsbuildinfo",
    "outDir": "dist",
    "rootDir": "."
  },
  "include": [
    "src/**/*.ts",
    "eslint-rules/**/*.ts",
    "scripts/**/*.ts",
    "scripts/**/*.mts",
    "vitest.config.ts",
    "eslint.config.ts",
    "commitlint.config.ts",
    "lint-staged.config.ts",
    "release.config.ts",
    "knip.config.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
