# Mass-deletion guard: reject a push that would delete an implausibly large
# number of files on the remote, which usually means a destructive commit
# slipped past pre-commit (--no-verify) or landed on another branch that was
# merged. Compares the local tip against the remote tip for each pushed ref.
THRESHOLD=100
zero="0000000000000000000000000000000000000000"

while read -r local_ref local_hash remote_ref remote_hash; do
  # Skip tag pushes
  case "$remote_ref" in
    refs/tags/*) continue ;;
  esac

  # Skip branch deletions (local hash is all zeros)
  if [ "$local_hash" = "$zero" ]; then
    continue
  fi

  # New branch — nothing to compare against
  if [ "$remote_hash" = "$zero" ]; then
    continue
  fi

  deleted=$(git diff --diff-filter=D --name-only "$remote_hash" "$local_hash" 2>/dev/null | wc -l | tr -d ' ')

  if [ "$deleted" -gt "$THRESHOLD" ]; then
    cat >&2 <<EOF
ERROR: Push to $remote_ref would delete $deleted files from the remote
(threshold: $THRESHOLD).
Aborting — this likely indicates a destructive commit in the push history.

If this is intentional, bypass with: git push --no-verify
EOF
    exit 1
  fi
done

# Run typecheck, schema validation, knip and the tests related to what the push changes. The full suite is CI's job: it runs there on every pull request, so repeating it here only repeats the same work for each push attempt, and again for each attempt that fails.
# The related tests are those vitest finds from the module graph for the files changed since the push diverged from origin/main, and a push that changes no source file has none to run, which is a pass. A change to the vitest config, package.json or the lockfile still reruns everything, as vitest treats those as triggers.
# Workers are the cores the machine's run queue leaves free, and at least one: vitest starts a pool the size of the core count by default, so several pushes at once on a shared machine each oversubscribe it, and every test slows until the guards against a hang fire on tests that did nothing wrong.
base=$(git merge-base origin/main HEAD) &&
workers=$(node -p "Math.max(1, os.availableParallelism() - Math.ceil(os.loadavg()[0]))") &&
pnpm typecheck && pnpm schema && git diff --exit-code schema/ && pnpm knip && pnpm test -- --changed "$base" --passWithNoTests --maxWorkers="$workers"
